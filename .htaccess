# Cache policy
# - HTML: always revalidate, so visitors get the latest asset ?v= hashes.
# - CSS/JS: cache long; the ?v=<hash> query string changes whenever content changes
#   (see .githooks/pre-commit).

<IfModule mod_headers.c>
	<FilesMatch "\.(html?)$">
		Header set Cache-Control "no-cache, must-revalidate"
		Header unset Expires
	</FilesMatch>
	<FilesMatch "\.(css|js)$">
		Header set Cache-Control "public, max-age=31536000"
	</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/html "access plus 0 seconds"
</IfModule>
