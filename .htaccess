# Cache policy
# - HTML: always revalidate, so visitors get the latest asset ?v= hashes.
# - CSS/JS: cache long; the ?v=<hash> query string changes whenever content changes
#   (see .githooks/pre-commit).

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTP:Accept-Encoding} gzip [NC]
	RewriteCond %{REQUEST_FILENAME}.gz -f
	RewriteRule ^(.+\.(css|js))$ $1.gz [QSA,L]
</IfModule>

<IfModule mod_mime.c>
	AddEncoding gzip .gz
	AddType text/css .css.gz
	AddType application/javascript .js.gz
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.css\.gz$">
		Header set Content-Type "text/css"
	</FilesMatch>
	<FilesMatch "\.js\.gz$">
		Header set Content-Type "application/javascript"
	</FilesMatch>
	<FilesMatch "\.(html?)$">
		Header set Cache-Control "no-cache, must-revalidate"
		Header unset Expires
	</FilesMatch>
	<FilesMatch "\.(css|js)(\.gz)?$">
		Header set Cache-Control "public, max-age=31536000"
		Header merge Vary Accept-Encoding
	</FilesMatch>
	<FilesMatch "\.(jpe?g|png|webp|svg|woff2?|ttf|eot)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
</IfModule>
